[Unit]
Description=BPI-W3 voice assistant: web panel (read-only state and logs)
# Панель только читает: состояние служб, журнал пользователя, spool и модели.
# Ничего не меняет, поэтому и авторизации нет — держим её в локальной сети.
After=voiced.service

[Service]
ExecStart=%h/models/tts-venv/bin/python %h/bpi-w3-voice-assistant/scripts/panel.py --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
